{
  "request": {
    "method": "PUT",
    "url": "/v1/auth/forgot-password",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.email"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "forgot-password-response.json"
  }
}
{
  "request": {
    "method": "POST",
    "url": "/v1/auth/register",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.email"
      },
      {
        "matchesJsonPath": "$.password"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Location": "/v1/auth/user/11111111-1111-1111-1111-111111111111"
    },
    "bodyFileName": "register-response.json"
  }
}
{
  "request": {
    "method": "PUT",
    "url": "/v1/auth/reset-password",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.email"
      },
      {
        "matchesJsonPath": "$.password"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "reset-password-response.json"
  }
}